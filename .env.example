# cPanel Clean-Room Appliance & Audit Configuration
PANEL_PORT=3000
PANEL_MODE=sandbox
PANEL_SYSROOT=./scratch/sysroot
PANEL_DB_PATH=./scratch/panel.db
PANEL_JWT_SECRET=change-this-secret-in-production

# Optional: Reference cPanel Target Configuration (for UAPI Inventory & Visual Audit Scripts)
CPANEL_HOST=cpanel.example-store.com
CPANEL_PORT=2083
CPANEL_USER=acme

# Authentication: Provide either password or UAPI token
CPANEL_PASS=
CPANEL_API_TOKEN=

# Automation & Redaction Settings
HEADLESS=true
REDACT_EXTRA_PATTERNS=admin@example-store.com,sales@studio-letters.com
SCREENSHOT_OUTPUT_DIR=docs/screenshots
