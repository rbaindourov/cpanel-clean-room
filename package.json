{
  "name": "cpanel-clean-room",
  "version": "1.0.0",
  "description": "Clean-room open-source Linux web hosting control panel appliance (TypeScript, React, SQLite WAL, Unix-socket root daemon) with 77-tool cPanel Jupiter parity and 1-click cpmove migration.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/rbaindourov/cpanel-clean-room.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node --experimental-strip-types packages/server/src/index.ts",
    "build": "tsc --noEmit",
    "build:web": "npm --workspace=@cpanel-clean-room/web run build",
    "test": "node --experimental-strip-types --test packages/*/src/**/*.test.ts",
    "test:e2e": "node tests/e2e/run_all_e2e.mjs",
    "test:all": "node --experimental-strip-types --test packages/*/src/**/*.test.ts && node tests/e2e/run_all_e2e.mjs",
    "lint": "tsc --noEmit",
    "inventory": "node scripts/cpanel_uapi_inventory.mjs",
    "screenshots": "node scripts/cpanel_screenshot_crawler.mjs",
    "audit:competitors": "node scripts/audit_competitor_repos.mjs",
    "score:gaps": "node scripts/score_feature_gap_matrix.mjs",
    "verify": "node scripts/verify_docs_integrity.mjs"
  },
  "keywords": [
    "cpanel",
    "control-panel",
    "web-hosting",
    "linux",
    "nginx",
    "php-fpm",
    "bind9",
    "postfix",
    "dovecot",
    "rspamd",
    "typescript",
    "react",
    "clean-room"
  ],
  "author": "cPanel Clean-Room Contributors",
  "license": "MIT"
}
