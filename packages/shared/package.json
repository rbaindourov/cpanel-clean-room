{
  "name": "@cpanel-clean-room/shared",
  "version": "1.0.0",
  "description": "Shared TypeScript data models, Zod RPC contracts, deterministic .htaccess-to-Nginx translator, and appliance constants.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./models": "./src/models.ts",
    "./rpc-schema": "./src/rpc-schema.ts",
    "./htaccess-translator": "./src/htaccess-translator.ts",
    "./constants": "./src/constants.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/**/*.test.ts"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  }
}
